{
  "version": 2,
  "builds": [
    { "src": "api/*.py", "use": "@vercel/python" },
    { "src": "frontend/index.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/conversations", "dest": "/api/conversations.py" },
    { "src": "/api/analyze", "dest": "/api/analyze.py" },
    { "src": "/(.*)", "dest": "/frontend/index.html" }
  ]
}